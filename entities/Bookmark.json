{
  "name": "Bookmark",
  "type": "object",
  "properties": {
    "book": {
      "type": "string",
      "description": "Book name (e.g., Genesis, Matthew)"
    },
    "chapter": {
      "type": "integer",
      "description": "Chapter number"
    },
    "verse": {
      "type": "integer",
      "description": "Verse number"
    },
    "text": {
      "type": "string",
      "description": "The verse text"
    },
    "reference": {
      "type": "string",
      "description": "Full reference (e.g., John 3:16)"
    },
    "notes": {
      "type": "string",
      "description": "Personal notes about the verse"
    }
  },
  "required": [
    "book",
    "chapter",
    "verse",
    "text",
    "reference"
  ]
}